# --- Recruitment CV storage (private disk; never under public/ or uploads/) ---
# Local development default:
RECRUITMENT_CV_DIR=./storage/recruitment/cv
# On VPS use an absolute path outside the project, e.g. /var/app-data/recruitment/cv,
# owned by the app user with mode 750, included in backups together with the MongoDB backup.

# --- AI CV matching (server only — never expose to the frontend) ---
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_PARSE_MODEL=
AI_EXPLAIN_MODEL=
AI_MAX_CV_CHARS=12000
AI_MONTHLY_CALL_LIMIT=500
