# --- Recruitment CV storage (private disk; never under public/ or uploads/) ---
# Local development default:
RECRUITMENT_CV_DIR=./storage/recruitment/cv
# On VPS use an absolute path outside the project, e.g. /var/app-data/recruitment/cv,
# owned by the app user with mode 750, included in backups together with the MongoDB backup.

# --- AI CV matching (server only — never expose to the frontend) ---
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_PARSE_MODEL=
AI_EXPLAIN_MODEL=
AI_MAX_CV_CHARS=12000
AI_MONTHLY_CALL_LIMIT=500


# --- Mailbox module (IMAP/SMTP webmail) ---
# 32-byte key as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_ENCRYPTION_KEY=
# Shared secret for GET|POST /api/v1/user/mailbox/cron/send-scheduled
# Send via header x-mailbox-cron-secret OR Authorization: Bearer <value>
# Query ?secret= is rejected. Prefer MAILBOX_CRON_SECRET; CRON_SECRET is an alias.
MAILBOX_CRON_SECRET=
# CRON_SECRET=
